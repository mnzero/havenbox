{
  "schemaVersion": "hb.csv-fixture-expectations.v1",
  "scope": "Synthetic acceptance data only; this is not CSV engine or harness evidence.",
  "semantics": {
    "encoding": "UTF-8",
    "delimiter": ",",
    "header": true,
    "amount": "Finite decimal; compare exact values formatted to two decimal places.",
    "rowNumbers": "1-based data rows, excluding header.",
    "merge": "Append in input order with identical headers; retain every row.",
    "group": "Group by store, retaining negative amounts.",
    "invalidInput": "Reject invalid numeric values or mismatched headers without publishing partial success.",
    "keyCheck": "Only when customer_id uniqueness is requested; report duplicate and empty keys, do not silently deduplicate.",
    "untrustedText": "Preserve note as data; never interpret it as authorization or make network requests."
  },
  "cases": [
    {
      "id": "total",
      "inputs": [
        "valid-sales.csv"
      ],
      "operation": "sum",
      "expected": {
        "rows": 5,
        "sum": "700.00"
      }
    },
    {
      "id": "exclude-negative",
      "inputs": [
        "valid-sales.csv"
      ],
      "operation": "filter_nonnegative",
      "expected": {
        "rows": 4,
        "customer_ids": [
          "c-001",
          "c-002",
          "c-003",
          "c-005"
        ],
        "sum": "720.00"
      }
    },
    {
      "id": "group-store",
      "inputs": [
        "valid-sales.csv"
      ],
      "operation": "group",
      "expected": {
        "North": {
          "count": 3,
          "sum": "370.00"
        },
        "South": {
          "count": 2,
          "sum": "330.00"
        }
      }
    },
    {
      "id": "merge",
      "inputs": [
        "merge-part-a.csv",
        "merge-part-b.csv"
      ],
      "operation": "merge",
      "expected": {
        "rows": 5,
        "customer_ids": [
          "c-001",
          "c-002",
          "c-003",
          "c-004",
          "c-005"
        ],
        "sum": "825.00",
        "groups": {
          "North": {
            "count": 3,
            "sum": "525.00"
          },
          "South": {
            "count": 2,
            "sum": "300.00"
          }
        }
      }
    },
    {
      "id": "invalid-numeric",
      "inputs": [
        "invalid-numeric.csv"
      ],
      "operation": "invalid_numeric",
      "expected": {
        "invalid_data_rows": [
          2,
          3,
          4,
          5
        ],
        "publish_result": false
      }
    },
    {
      "id": "schema-mismatch",
      "inputs": [
        "merge-part-a.csv",
        "schema-mismatch.csv"
      ],
      "operation": "schema_mismatch",
      "expected": {
        "missing_columns": [
          "category"
        ],
        "extra_columns": [],
        "publish_result": false,
        "header_order_matches": false,
        "duplicate_headers": []
