#!/bin/sh
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

fail() {
    printf 'HB11_INIT_FAIL %s\n' "$1" >/dev/console
    poweroff -f || true
    while :; do sleep 3600; done
}

mkdir -p /dev /proc /sys /newroot
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
for module in virtio_blk crc16 mbcache jbd2 quota_tree quota_v2 ext4; do
    insmod "/lib/modules/${module}.ko.gz" || fail "module:$module"
done
for unused in 1 2 3 4 5; do
    [ -b /dev/vda ] && [ -b /dev/vdb ] && break
    sleep 1
done
[ -b /dev/vda ] && [ -b /dev/vdb ] || fail missing-disks
mount -o ro /dev/vda /newroot || fail root-mount
umount /proc
umount /sys
umount /dev
exec switch_root /newroot /sbin/hb-init
