{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:havenbox:compatibility-matrix:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": "hb.compatibility.v1"},
    "combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"const": "builtin-kimi-k3-1-pro-csv"},
          "harness": {"const": "builtin"},
          "adapterRevision": {"const": "builtin-agent.mvp.v1-candidate"},
          "toolPolicyRevision": {"const": "csv-approved-only-v1-candidate"},
          "toolEntryPoints": {
            "type": "array",
            "items": {"const": "cli"},
            "minItems": 1,
            "uniqueItems": true
          },
          "route": {
            "type": "object",
            "properties": {
              "mode": {"const": "online"},
              "provider": {"const": "Moonshot AI Kimi API"},
              "providerRevision": {"const": "kimi-api-docs-2026-10-23"},
              "credentialVersion": {"const": "host-keychain-moonshot-api-key-v1"},
              "protocol": {"const": "openai-chat-completions-v1"},
              "modelId": {"const": "kimi-k3.1-pro"},
              "endpoint": {"const": "https://api.moonshot.cn/v1/chat/completions"},
              "endpointRevision": {"const": "moonshot-chat-completions-2026-10-23"},
              "parametersRevision": {"const": "mvp01-kimi-k3-1-pro-1"},
              "capabilities": {
                "type": "object",
                "properties": {
                  "tools": {"const": "strict-function-json-schema"},
                  "structuredPlan": {"const": "response-format-json-schema"},
                  "streaming": {"const": "sse-with-usage"}
                },
                "required": ["tools", "structuredPlan", "streaming"],
                "additionalProperties": false
              },
              "officialSources": {
                "type": "array",
                "items": {
                  "enum": [
                    "https://platform.moonshot.cn/docs/api",
                    "https://platform.moonshot.cn/docs/api/chat",
                    "https://platform.moonshot.cn/docs/api/tool-use",
                    "https://platform.moonshot.cn/docs/guide/start-using-kimi-api"
                  ]
                },
                "minItems": 4,
                "uniqueItems": true
              },
              "resourceRevision": {"type": "null"},
              "runtimeRevision": {"type": "null"},
              "templateDigest": {"type": "null"},
              "quantization": {"type": "null"}
            },
            "required": [
              "mode", "provider", "providerRevision", "credentialVersion", "protocol",
              "modelId", "endpoint", "endpointRevision", "parametersRevision",
              "capabilities", "officialSources", "resourceRevision", "runtimeRevision",
              "templateDigest", "quantization"
            ],
            "additionalProperties": false
          },
          "state": {"enum": ["candidate", "probe", "validated", "frozen"]},
          "recovery": {"const": "single-task-read-only-history-no-replay"},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "properties": {
              "mvp07": {
                "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
              },
              "mvp08": {
                "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
              }
            },
            "required": ["mvp07", "mvp08"],
            "additionalProperties": false
          }
        },
        "required": [
          "id", "harness", "adapterRevision", "toolPolicyRevision", "toolEntryPoints",
          "route", "state", "recovery", "reason", "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    }
  },
  "required": ["schemaVersion", "combinations"],
  "additionalProperties": false
}
