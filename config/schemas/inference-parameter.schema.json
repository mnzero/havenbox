{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:havenbox:inference-parameter:v1",
  "$defs": {
    "tokenRule": {
      "type": "object",
      "properties": {
        "supported": {"const": true},
        "default": {"type": "integer", "minimum": 1},
        "valueSchema": {
          "type": "object",
          "properties": {
            "type": {"const": "integer"},
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          },
          "required": ["type", "minimum", "maximum"],
          "additionalProperties": false
        }
      },
      "required": ["supported", "default", "valueSchema"],
      "additionalProperties": false
    },
    "temperatureRule": {
      "type": "object",
      "properties": {
        "supported": {"const": false},
        "default": {"const": "omitted"},
        "valueSchema": {
          "type": "object",
          "properties": {
            "enum": {"type": "array", "items": {"const": "omitted"}, "minItems": 1, "uniqueItems": true}
          },
          "required": ["enum"],
          "additionalProperties": false
        }
      },
      "required": ["supported", "default", "valueSchema"],
      "additionalProperties": false
    },
    "reasoningRule": {
      "type": "object",
      "properties": {
        "supported": {"const": true},
        "default": {"enum": ["low", "high", "max"]},
        "valueSchema": {
          "type": "object",
          "properties": {
            "enum": {
              "type": "array",
              "items": {"enum": ["low", "high", "max"]},
              "minItems": 3,
              "uniqueItems": true
            }
          },
          "required": ["enum"],
          "additionalProperties": false
        }
      },
      "required": ["supported", "default", "valueSchema"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {"const": "hb.inference-parameters.v1"},
    "revision": {"const": "mvp01-kimi-k3-1-pro-1"},
    "status": {"const": "candidate"},
    "fields": {
      "type": "object",
      "properties": {
        "contextTokens": {"$ref": "#/$defs/tokenRule"},
        "maxOutputTokens": {"$ref": "#/$defs/tokenRule"},
        "temperature": {"$ref": "#/$defs/temperatureRule"},
        "reasoningEffort": {"$ref": "#/$defs/reasoningRule"}
      },
      "required": ["contextTokens", "maxOutputTokens", "temperature", "reasoningEffort"],
      "additionalProperties": false
    },
    "mutuallyExclusive": {"type": "array", "minItems": 0, "uniqueItems": true},
    "protocol": {
      "type": "object",
      "properties": {
        "maxOutputTokensField": {"const": "max_completion_tokens"},
        "reasoningEffortField": {"const": "reasoning_effort"},
        "responseFormat": {"const": "json_schema"},
        "toolMode": {"const": "strict-function"},
        "stream": {"const": true},
        "streamOptions": {
          "type": "object",
          "properties": {"includeUsage": {"const": true}},
          "required": ["includeUsage"],
          "additionalProperties": false
        },
        "omittedParameters": {
          "type": "array",
          "items": {"enum": ["temperature", "top_p", "presence_penalty", "frequency_penalty"]},
          "minItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "maxOutputTokensField", "reasoningEffortField", "responseFormat", "toolMode",
        "stream", "streamOptions", "omittedParameters"
      ],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "revision", "status", "fields", "mutuallyExclusive", "protocol"],
  "additionalProperties": false
}
